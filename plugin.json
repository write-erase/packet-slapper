{
  "name": "Packet Slapper",
  "version": "1.3.0",
  "description": "Runs scheduled or on-demand Ookla speedtests through Dispatcharr's own network connection, with alerts and optional Discord posts and Prometheus metrics.",
  "author": "write-erase",
  "fields": [
    {
      "id": "scheduler_interval",
      "label": "Scheduler",
      "type": "select",
      "default": "off",
      "help_text": "Runs a speedtest automatically on an interval or at set times. Changes take effect within about 15 seconds of saving. Turning it off lets a test that's already running finish.",
      "options": [
        {
          "value": "off",
          "label": "Off"
        },
        {
          "value": "5",
          "label": "Every 5 minutes"
        },
        {
          "value": "10",
          "label": "Every 10 minutes"
        },
        {
          "value": "15",
          "label": "Every 15 minutes"
        },
        {
          "value": "30",
          "label": "Every 30 minutes"
        },
        {
          "value": "60",
          "label": "Every hour"
        },
        {
          "value": "120",
          "label": "Every 2 hours"
        },
        {
          "value": "180",
          "label": "Every 3 hours"
        },
        {
          "value": "360",
          "label": "Every 6 hours"
        },
        {
          "value": "720",
          "label": "Every 12 hours"
        },
        {
          "value": "1440",
          "label": "Every 24 hours"
        },
        {
          "value": "times",
          "label": "At set times (see 'Run at')"
        }
      ]
    },
    {
      "id": "run_at_times",
      "label": "Run at",
      "type": "string",
      "default": "",
      "placeholder": "03:00, 15:00",
      "help_text": "Used when Scheduler is 'At set times'. 24-hour times in your timezone, separated by commas."
    },
    {
      "id": "skip_if_streaming",
      "label": "Skip scheduled tests while someone is watching",
      "type": "boolean",
      "default": true,
      "help_text": "Speedtests use real bandwidth, so a scheduled test waits while anyone is watching live TV, VOD or catch-up, and tries again every 30 minutes. 'Run speedtest now' always runs."
    },
    {
      "id": "run_now_wait",
      "label": "Run speedtest now: wait for the result",
      "type": "boolean",
      "default": false,
      "help_text": "Off: the test runs in the background and the result pops up when it's done (about 30 seconds). On: the button waits and shows the result in its own popup."
    },
    {
      "id": "display_timezone",
      "label": "Timezone",
      "type": "select",
      "default": "UTC",
      "help_text": "Used for the times in results, Status and 'Run at'.",
