    {
      "id": "discord_webhook_url",
      "label": "Discord Webhook URL",
      "type": "string",
      "input_type": "password",
      "default": "",
      "placeholder": "Optional - leave blank to only see results in Dispatcharr.",
      "help_text": "If configured, each result is posted to Discord via webhook."
    },
    {
      "id": "discord_style",
      "label": "Discord Message Style",
      "type": "select",
      "default": "embed",
      "options": [
        {
          "value": "embed",
          "label": "Embed (colored card)"
        },
        {
          "value": "plain",
          "label": "Plain text (classic)"
        }
      ],
      "help_text": "Only used when a Discord webhook URL is configured."
    },
    {
      "id": "server_id",
      "label": "Speedtest Server ID",
      "type": "string",
      "default": "",
      "placeholder": "Blank = auto-select",
      "help_text": "Specify an Ookla server by its numeric ID so results are comparable from run to run. Leave blank to let the tool pick the fastest server each time."
    }
  ],
  "actions": [
    {
      "id": "run_now",
      "label": "Run Speedtest Now",
      "description": "Runs a speed test and returns the results. Results are also sent to Discord if a webhook is configured.",
      "button_label": "Run Now",
      "button_variant": "filled",
      "button_color": "blue"
    },
    {
      "id": "test_webhook",
      "label": "Send Test Message",
      "description": "Posts a test message to your Discord webhook (if you set one), without running a speedtest.",
      "button_label": "Test Webhook",
      "button_variant": "filled",
      "button_color": "blue"
    },
    {
      "id": "scheduler_status",
      "label": "Scheduler Status",
      "description": "Shows whether the scheduler is running, when it started, when the next test is due, and how the last test went.",
      "button_label": "Status",
      "button_variant": "filled",
      "button_color": "blue"
    },
    {
      "id": "check_streams",
      "label": "Check Active Streams",
      "description": "Shows whether anyone is watching (live, VOD or catch-up) and which signals matched. This is what the scheduler checks before skipping a run. Does not run a speedtest.",
      "button_label": "Check",
      "button_variant": "filled",
      "button_color": "blue"
    }
  ]
