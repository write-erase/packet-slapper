{
  "name": "Packet Slapper",
  "version": "1.0.2",
  "description": "Runs scheduled or on-demand Ookla Speedtests through Dispatcharr to measure speed and latency.",
  "author": "write-erase",
  "fields": [
    {
      "id": "scheduler_interval",
      "label": "Scheduler",
      "type": "select",
      "default": "off",
      "help_text": "Runs a Speedtest automatically on the chosen interval, or choose Off to disable. Changes take effect within about 15 seconds of saving. Turning it off allows any test already in progress to finish first.",
      "options": [
        {
          "value": "off",
          "label": "Off (scheduler disabled)"
        },
        {
          "value": "5",
          "label": "Every 5 minutes"
        },
        {
          "value": "10",
          "label": "Every 10 minutes"
        },
        {
          "value": "15",
          "label": "Every 15 minutes"
        },
        {
          "value": "30",
          "label": "Every 30 minutes"
        },
        {
          "value": "60",
          "label": "Every hour"
        },
        {
          "value": "120",
          "label": "Every 2 hours"
        },
        {
          "value": "180",
          "label": "Every 3 hours"
        },
        {
          "value": "360",
          "label": "Every 6 hours"
        },
        {
          "value": "720",
          "label": "Every 12 hours"
        },
        {
          "value": "1440",
          "label": "Every 24 hours"
        }
      ]
    },
    {
      "id": "skip_if_streaming",
      "label": "Skip run if channels are streaming",
      "type": "boolean",
      "default": true,
      "help_text": "Speedtests use real bandwidth. Scheduled tests are skipped when Dispatcharr is actively in use."
    },
