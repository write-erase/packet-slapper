    {
      "id": "discord_webhook_url",
      "label": "Discord webhook URL",
      "type": "string",
      "input_type": "password",
      "default": "",
      "placeholder": "https://discord.com/api/webhooks/…",
      "help_text": "Results are posted to this Discord channel. Leave blank to see them only in Dispatcharr."
    },
    {
      "id": "discord_style",
      "label": "Discord message style",
      "type": "select",
      "default": "embed",
      "options": [
        {
          "value": "embed",
          "label": "Embed (colored card)"
        },
        {
          "value": "plain",
          "label": "Plain text (classic)"
        }
      ],
      "help_text": "Only used with a Discord webhook."
    },
    {
      "id": "discord_include_exit_ip",
      "label": "Include exit IP in Discord posts",
      "type": "boolean",
      "default": false,
      "help_text": "Adds the public IP the test went out through, under ISP. It always shows in Dispatcharr. Leave off if others can read the channel."
    },
    {
      "id": "discord_post_mode",
      "label": "Discord posts",
      "type": "select",
      "default": "every",
      "options": [
        {
          "value": "every",
          "label": "Every result (alerts highlighted)"
        },
        {
          "value": "alerts",
          "label": "Only alerts and recoveries"
        }
      ],
      "help_text": "With 'Only alerts and recoveries', Discord gets one post when an alert starts or changes (or a test fails), and one when everything is back to normal."
    },
    {
      "id": "server_id",
      "label": "Speedtest server ID",
      "type": "string",
      "default": "",
      "placeholder": "Auto-select",
      "help_text": "Pins tests to one Ookla server so results are comparable from run to run. 'Find servers' lists the nearest IDs. Leave blank to let Ookla pick a server each time."
    },
    {
      "id": "cli_auto_update",
      "label": "Keep the Speedtest CLI up to date",
      "type": "boolean",
      "default": true,
      "help_text": "Checks Ookla for a newer Speedtest CLI at most once a day and switches to it after a trial start. Turn off to stay on your current version (a missing CLI is still downloaded)."
    },
    {
      "id": "prometheus_enabled",
      "label": "Publish results for Prometheus",
      "type": "boolean",
      "default": false,
      "help_text": "Saves each result in Redis for the Dispatcharr Exporter plugin to serve as dispatcharr_speedtest_* metrics. Only needed if you scrape Dispatcharr with Prometheus."
    },
    {
      "id": "vpn_check",
      "label": "Alert: VPN check",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto (alert if the VPN stops being used)"
        },
        {
          "value": "always",
          "label": "Always expect a VPN"
        },
        {
          "value": "off",
          "label": "Off"
        }
      ],
      "help_text": "Checks that speedtests go through your VPN. Works when Dispatcharr uses a VPN container's network, like Gluetun. On Auto, you get an alert if a test skips the VPN after earlier tests used it. A VPN running on your router can't be detected."
    },
    {
      "id": "alert_min_download_mbps",
      "label": "Alert: download below (Mbps)",
      "type": "number",
      "placeholder": "Off",
      "help_text": "Leave this and the alerts below blank, or 0, to turn them off."
    },
    {
      "id": "alert_min_upload_mbps",
      "label": "Alert: upload below (Mbps)",
      "type": "number",
      "placeholder": "Off"
    },
    {
      "id": "alert_max_loss_pct",
      "label": "Alert: packet loss above (%)",
      "type": "number",
      "placeholder": "Off"
    },
    {
      "id": "alert_max_loaded_latency_ms",
      "label": "Alert: loaded ping above (ms)",
      "type": "number",
      "placeholder": "Off",
      "help_text": "Ping while downloading (bufferbloat). Try about 2× your usual loaded ping."
    }
  ],
  "actions": [
    {
      "id": "run_now",
      "label": "Run speedtest now",
      "description": "Runs a speedtest now. The result pops up here when it's done (about 30 seconds) and goes to Discord (if set up), the log and Status.",
      "button_label": "   Run   ",
      "button_variant": "filled",
      "button_color": "blue"
    },
    {
      "id": "test_webhook",
      "label": "Send test message",
      "description": "Posts a test message to your Discord webhook without running a speedtest.",
      "button_label": "  Test  ",
      "button_variant": "filled",
      "button_color": "blue"
    },
    {
      "id": "scheduler_status",
      "label": "Status",
      "description": "Shows the schedule, when the next test is due, how the last test went, and any active alerts.",
      "button_label": "Status",
      "button_variant": "filled",
      "button_color": "blue"
    },
    {
      "id": "check_streams",
      "label": "Check active streams",
      "description": "Shows whether anyone is watching live TV, VOD or catch-up right now: what the scheduler checks before skipping a test. Details go to the log. Doesn't run a speedtest.",
      "button_label": "Check",
      "button_variant": "filled",
      "button_color": "blue"
    },
    {
      "id": "find_servers",
      "label": "Find servers",
      "description": "Lists the Ookla servers nearest to Dispatcharr's connection, for 'Speedtest server ID'. The nearest three show here; the full list goes to Discord (if set up) and the log. Doesn't run a speedtest.",
      "button_label": "  Find  ",
      "button_variant": "filled",
      "button_color": "blue"
    }
  ]
}
